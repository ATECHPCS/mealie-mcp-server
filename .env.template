# Mealie API Configuration
# Replace these values with your own Mealie instance details

# The base URL of your Mealie instance (including protocol and port if needed)
MEALIE_BASE_URL=https://your-mealie-instance.com

# Your Mealie API key
# Generate this from your Mealie account settings
MEALIE_API_KEY=your-mealie-api-key

LOG_LEVEL=INFO

# Auto-cleanup on import: after import_recipe_from_url scrapes a recipe, run the
# full ingredient cleanup (structure quantity/unit/food, split compounds,
# resolve "X or Y" alternatives, promote section headers, dedupe foods) so
# downstream consumers (e.g. the Grocy importer) never see raw notes. Fail-safe.
# MEALIE_IMPORT_AUTO_CLEANUP=true
# MEALIE_IMPORT_CLEANUP_REVIEWS=true   # false = deterministic fixes only

# Auto image backfill (streamable-http transport only): auto-generates a
# recipe image via generate_recipe_image once a recipe is this many minutes
# old and still has no real image, so there's a manual-upload window first.
# AUTO_IMAGE_BACKFILL_ENABLED=true
# AUTO_IMAGE_BACKFILL_DELAY_MINUTES=5
# AUTO_IMAGE_BACKFILL_POLL_SECONDS=60
# AUTO_IMAGE_BACKFILL_WINDOW_MINUTES=180
